# Copy to .env and fill in. A blank value falls back to the default below.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_API_URL=https://api.green-api.com
# Files are sent to the media host. Leave blank to derive it from the API URL
# (https://7105.api.greenapi.com -> https://7105.media.greenapi.com).
GREEN_API_MEDIA_URL=
ADMIN_API_KEY=
DATA_FILE_PATH=data/users.json
# Where images the bot sends live, relative to the repository root.
ASSETS_DIR=assets
# Set to DEBUG to also log every webhook body and GREEN-API response.
LOG_LEVEL=INFO
